# --- Supabase -------------------------------------------------------------
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://cmdglovohcvvivgalhol.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNtZGdsb3ZvaGN2dml2Z2FsaG9sIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTk5NDA1NDQsImV4cCI6MjA3NTUxNjU0NH0.c-Jwy-F4yO5j9BekpcFQs6koetJuzXc8S0LmiaP2dPA
# Clé « service_role » : NE JAMAIS l'exposer côté navigateur.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=BIZELAN

# --- E-mails transactionnels (optionnel, Resend) --------------------------
# Laisser vide désactive proprement l'envoi d'e-mails ; le site continue de fonctionner.
RESEND_API_KEY=
EMAIL_FROM="BIZELAN <contact@bizelan.com>"
# Adresse qui reçoit les demandes de devis et notifications de commande
ADMIN_NOTIFICATION_EMAIL=contactbizelan@gmail.com

# --- Hébergement vidéo (optionnel, Bunny Stream) --------------------------
# Si non renseigné, l'admin accepte quand même les URLs vidéo directes ou YouTube.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
NEXT_PUBLIC_BUNNY_STREAM_CDN_HOSTNAME=
