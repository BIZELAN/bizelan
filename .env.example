# ---------------------------------------------------------------------------
# BIZELAN — variables d'environnement
# Copier ce fichier en `.env.local` pour le développement,
# et renseigner les mêmes clés dans Vercel > Settings > Environment Variables.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique
# Clé « service_role » : NE JAMAIS l'exposer côté navigateur.
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# --- SasPay ---------------------------------------------------------------
# Tableau de bord : https://app.saspay.me — Developers > API keys
# Encaissement Mobile Money (MTN, Moov, Celtiis) par demande poussée sur le
# téléphone : le client ne quitte pas le site.
SASPAY_API_KEY=sk_live_votre_cle_saspay
# Secret de signature du webhook. Affiché UNE SEULE FOIS à la création du
# webhook ou lors d'une rotation : s'il est perdu, il faut en générer un autre.
# C'est une valeur DISTINCTE de la clé d'API.
SASPAY_WEBHOOK_SECRET=

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=BIZELAN

# --- E-mails transactionnels (optionnel, Resend) --------------------------
# Laisser vide désactive proprement l'envoi d'e-mails ; le site continue de fonctionner.
RESEND_API_KEY=
EMAIL_FROM="BIZELAN <contact@bizelan.com>"
# Adresse qui reçoit les demandes de devis et notifications de commande
ADMIN_NOTIFICATION_EMAIL=

# --- Hébergement vidéo (optionnel, Bunny Stream) --------------------------
# Si non renseigné, l'admin accepte quand même les vidéos téléversées,
# les liens MP4 directs et YouTube.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
NEXT_PUBLIC_BUNNY_STREAM_CDN_HOSTNAME=
